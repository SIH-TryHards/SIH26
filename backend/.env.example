# Copy to backend/.env and edit. NEVER commit the real .env.
# development keeps stub OTP visible in the response for local testing.
# production keeps OTP_MODE=stub but never returns dev_code in the API.
APP_ENV=development
OTP_MODE=stub
# Required in production. Use a random value of at least 32 UTF-8 bytes.
JWT_SECRET=
# Token lifetimes (minutes)
FARMER_TOKEN_MINUTES=10080
OFFICER_TOKEN_MINUTES=480
# Seeded officer account (created or updated idempotently on startup)
OFFICER_STAFF_ID=OFF-1001
OFFICER_NAME=A. Kulkarni
OFFICER_DISTRICT=Nashik
OFFICER_PASSWORD=
# data.gov.in API key for live mandi prices (get from https://data.gov.in)
# Leave empty to use simulated prices fallback
DATAGOVIN_API_KEY=
# Comma-separated origins. Production must include the live frontend origin.
CORS_ORIGINS=https://kisan-saathi.pages.dev,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
# Optional writable SQLite location; default is backend/data/kisan.db
KISAN_DB_PATH=data/kisan.db
LOG_LEVEL=INFO
