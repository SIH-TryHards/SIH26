# Copy to backend/.env and edit. NEVER commit the real .env.
# stub = OTP returned in the API response + printed to console (demo only)
# provider = a real SMS gateway would be called (not wired yet)
OTP_MODE=stub
# Change for any deployment beyond the demo
JWT_SECRET=change-me-in-production
# Token lifetimes (minutes)
FARMER_TOKEN_MINUTES=10080
OFFICER_TOKEN_MINUTES=480
# Seeded officer account (created on first start)
OFFICER_STAFF_ID=OFF-1001
OFFICER_NAME=A. Kulkarni
OFFICER_DISTRICT=Nashik
OFFICER_PASSWORD=Kisan@2026
# data.gov.in API key for live mandi prices (get from https://data.gov.in)
# Leave empty to use simulated prices fallback
DATAGOVIN_API_KEY=
# Comma-separated CORS origins (default: localhost variants)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
